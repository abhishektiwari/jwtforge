#!/usr/bin/env bash
set -euo pipefail

protected_branch="main"
current_branch=$(git rev-parse --abbrev-ref HEAD)

if [[ "$current_branch" != "$protected_branch" ]]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/$protected_branch" ]]; then
    continue
  fi

  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    echo "Skipping package version guard for initial push to $protected_branch."
    continue
  fi

  base_version=$(git show "$remote_sha:package.json" | node -e "let data=''; process.stdin.on('data', chunk => data += chunk); process.stdin.on('end', () => console.log(JSON.parse(data).version || ''));")
  local_version=$(git show "$local_sha:package.json" | node -e "let data=''; process.stdin.on('data', chunk => data += chunk); process.stdin.on('end', () => console.log(JSON.parse(data).version || ''));")

  if [[ "$base_version" == "$local_version" ]]; then
    cat >&2 <<'EOF'
Push blocked: package.json version must change when pushing to main.

Update the release version before pushing, for example:
  npm version patch --no-git-tag-version
EOF
    exit 1
  fi
done
