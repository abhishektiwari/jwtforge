{
  "name": "jwtforge",
  "description": "JWT Token Vending Service for Testing",
  "repository": "https://github.com/abhishektiwari/jwtforge",
  "compatibility_date": "2024-01-01",
  "main": "src/index.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "KEYSTORE",
        "class_name": "KeyStore",
        "script_name": "jwtforge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["KeyStore"]
    }
  ],
  "vars": {
    "ISSUER": "https://jwtforge.example.com"
  }
}
