digraph researcher_workflow {
    fontname="Helvetica,Arial,sans-serif"
    graph [ranksep=0.35, nodesep=0.28, margin=0.03]
    node [fontname="Helvetica,Arial,sans-serif", fontsize=10, margin="0.08,0.05", style=filled]
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=9]
    rankdir=TB;

    start [label="Security Testing Engagement", shape=box, fillcolor="#E8F4F8", style="filled,rounded"]
    setup [label="Setup JWTForge\n(Local or Remote)", shape=box, fillcolor="#FCE4EC"]
    openapi [label="Analyze OpenAPI Spec\n(Endpoints, auth schemes, scopes)", shape=box, fillcolor="#E8F4F8"]
    design [label="Design Test Scenarios\n(Claims, headers, formats, permissions)", shape=box, fillcolor="#FFF4E6"]
    payload [label="Generate Adversarial Tokens\n(injection/fuzz/alg confusion/format confusion/grammar)", shape=box, fillcolor="#FFF4E6"]
    captured [label="Captured Baseline Token\n(Authorized Test Session)", shape=box, fillcolor="#E8F4F8"]
    mutation [label="POST /mutation: Explicit Groups\nHeader / Claim / Signature / Format Edits\n(no automatic re-signing)", shape=box, fillcolor="#FFF4E6"]
    pentest [label="Generate/Run JWT Pentest Plan\n(OpenAPI-derived operations)", shape=box, fillcolor="#FFF4E6"]
    postman_test [label="Replay Baseline and Test Tokens\n(Test Harness Against Target APIs)", shape=box, fillcolor="#E8F5E9"]
    analyze [label="Compare Baseline / Variant Responses\n(Authorization Decisions, Errors, Timing)", shape=box, fillcolor="#E8F5E9"]
    document [label="Document Findings\n(Generate Report)", shape=box, fillcolor="#F3E5F5"]
    disclose [label="Responsible Disclosure", shape=box, fillcolor="#E0F2F1", style="filled,rounded"]

    { rank=same; setup; openapi }
    { rank=same; design; payload }
    { rank=same; document; disclose }

    start -> setup
    setup -> openapi
    openapi -> design
    design -> payload
    design -> captured [style=dashed, label="import path"]
    captured -> mutation
    payload -> mutation [style=dashed, label="generated source"]
    mutation -> postman_test [label="independent variants"]
    payload -> pentest
    pentest -> postman_test
    postman_test -> analyze
    analyze -> document
    document -> disclose
}
