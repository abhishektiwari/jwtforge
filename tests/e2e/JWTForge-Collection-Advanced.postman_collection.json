                  "key": "subject_token",
                  "value": "{{grammar_token}}",
                  "type": "text"
                },
                {
                  "key": "subject_token_type",
                  "value": "urn:ietf:params:oauth:token-type:jwt",
                  "type": "text"
                },
                {
                  "key": "requested_token_type",
                  "value": "urn:ietf:params:oauth:token-type:access_token",
                  "type": "text"
                },
                {
                  "key": "resource",
                  "value": "https://api.example.com",
                  "type": "text"
                },
                {
                  "key": "add_claims",
                  "value": "scope:read write,department:engineering",
                  "type": "text"
                },
                {
                  "key": "remove_claims",
