    {
      "name": "Grammar Mode",
      "description": "Generate tokens using FBNF grammar patterns",
      "item": [
        {
          "name": "Grammar - Valid Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"grammar\",\n  \"grammar_category\": \"valid\",\n  \"sub\": \"user123\",\n  \"scope\": \"openid profile email\",\n  \"client_id\": \"client_123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Generate token with valid grammar patterns - standard RFC-compliant values"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains access_token\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.exist;",
                  "});",
                  "pm.test(\"Token is valid JWT format\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    var parts = jsonData.access_token.split('.');",
                  "    pm.expect(parts.length).to.equal(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
