    {
      "name": "Test Flow Setup",
      "description": "Setup requests to generate tokens for advanced testing",
      "item": [
        {
          "name": "Setup - Generate Grammar Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"grammar_token\", jsonData.access_token);",
                  "    pm.test(\"✓ Grammar token saved\", function() {",
                  "        pm.expect(jsonData.access_token).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
