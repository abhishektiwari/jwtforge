      "item": [
        {
          "name": "Generate Token - Basic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"user123\",\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"client_id\": \"client_123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Generate a basic JWT token with custom claims",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"jwt_token\", jsonData.access_token);",
                    "    pm.test(\"✓ Token saved to {{jwt_token}}\", function() {",
                    "        pm.expect(jsonData.access_token).to.exist;",
                    "    });",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
