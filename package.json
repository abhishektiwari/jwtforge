{
  "name": "jwtforge",
  "version": "0.1.1",
  "description": "JWT token vending service for testing with JWKS and OIDC discovery endpoints",
  "main": "src/index.js",
  "bin": {
    "jwtforge": "bin/jwtforge.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cli": "wrangler dev --show-interactive-dev-session=false > /dev/null 2>&1",
    "docs:start": "docusaurus start",
    "docs:build": "docusaurus build",
    "docs:serve": "docusaurus serve",
    "docs:clear": "docusaurus clear",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:worker-bundle": "wrangler deploy --dry-run --outdir .wrangler/worker-bundle-check && node scripts/check-worker-bundle.js .wrangler/worker-bundle-check"
  },
  "keywords": [
    "jwt",
    "oidc",
    "oauth2",
    "jwks",
    "cloudflare-workers",
    "testing"
  ],
  "author": "Abhishek Tiwari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishektiwari/jwtforge.git"
  },
  "homepage": "https://github.com/abhishektiwari/jwtforge#readme",
  "bugs": {
    "url": "https://github.com/abhishektiwari/jwtforge/issues",
    "email": "abhishek@abhishek-tiwari.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/abhishektiwari"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "blns": "^2.0.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "babel-jest": "^30.4.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-llms": "^0.5.1",
    "jest": "^30.4.2",
    "newman": "^6.2.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wrangler": "^4.100.0"
  }
}
