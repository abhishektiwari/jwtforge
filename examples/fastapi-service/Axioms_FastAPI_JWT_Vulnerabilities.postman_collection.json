    {
      "name": "5. Format Confusion",
      "description": "JWS JSON Serialization tokens should be rejected by APIs expecting compact OAuth2/OIDC bearer JWTs.",
      "item": [
        {
          "name": "Generate Flattened JWS JSON Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWTForge returned flattened JWS JSON token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    const token = jsonData.access_token || jsonData.id_token;",
