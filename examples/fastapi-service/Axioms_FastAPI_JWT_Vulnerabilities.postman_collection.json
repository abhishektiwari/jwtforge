{
  "info": {
    "_postman_id": "axioms-fastapi-jwt-vulnerabilities-001",
    "name": "Axioms FastAPI JWT Vulnerability Tests",
    "description": "Postman collection for testing common JWT validation vulnerabilities against the Axioms FastAPI example API. JWTForge generates the test tokens; the target API should reject forged or unsafe tokens with 401 or 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseline_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "attack_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "signature_removed_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "signature_replaced_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "signature_truncated_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "signature_bit_flipped_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Baseline",
      "description": "Verify the example API accepts a normal signed JWT before running negative tests.",
      "item": [
        {
          "name": "Generate Baseline Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWTForge returned a baseline access token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.exist;",
                  "    pm.collectionVariables.set('baseline_token', jsonData.access_token);",
                  "});",
                  "",
                  "pm.test('Baseline token has JWT format', function () {",
                  "    const token = pm.collectionVariables.get('baseline_token');",
                  "    pm.expect(token.split('.')).to.have.length(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"header\": {\n    \"typ\": \"JWT\"\n  },\n  \"body\": {\n    \"iss\": \"{{issuer}}\",\n    \"aud\": \"{{audience}}\",\n    \"sub\": \"security-test-user\",\n    \"scope\": \"read:data openid\",\n    \"roles\": [\"admin\", \"superuser\"],\n    \"permissions\": [\"resource:create\"]\n  }\n}"
            },
            "url": {
              "raw": "{{jwtforge_url}}/token",
              "host": [
                "{{jwtforge_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Generate a normal signed token with claims accepted by the protected example endpoints."
          }
        },
        {
          "name": "Protected Endpoint Accepts Baseline Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Baseline token is accepted', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{baseline_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "protected"
              ]
            },
            "description": "Sanity check: if this fails, fix JWTForge issuer/audience configuration before interpreting vulnerability tests."
          }
        }
      ]
    },
    {
      "name": "2. Signature Tampering",
      "description": "Derive signature-only variants from the exact baseline accepted in the previous folder. The protected header and payload remain unchanged.",
      "item": [
        {
          "name": "Mutate Baseline Signatures",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWTForge returned all signature mutations', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.count).to.eql(4);",
                  "    pm.expect(jsonData.results.map(function (result) { return result.id; })).to.have.members(['signature-remove', 'signature-replace', 'signature-truncate', 'signature-flip-bit']);",
                  "});",
                  "",
                  "const results = pm.response.json().results;",
                  "const tokens = {};",
                  "results.forEach(function (result) { tokens[result.id] = typeof result.token === 'string' ? result.token : JSON.stringify(result.token); });",
                  "pm.collectionVariables.set('signature_removed_token', tokens['signature-remove']);",
                  "pm.collectionVariables.set('signature_replaced_token', tokens['signature-replace']);",
                  "pm.collectionVariables.set('signature_truncated_token', tokens['signature-truncate']);",
                  "pm.collectionVariables.set('signature_bit_flipped_token', tokens['signature-flip-bit']);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{baseline_token}}\",\n  \"mutations\": [\n    {\n      \"id\": \"signature-remove\",\n      \"operations\": [{\"type\": \"signature\", \"operation\": \"remove\"}]\n    },\n    {\n      \"id\": \"signature-replace\",\n      \"operations\": [{\"type\": \"signature\", \"operation\": \"replace\", \"value\": \"AQID\"}]\n    },\n    {\n      \"id\": \"signature-truncate\",\n      \"operations\": [{\"type\": \"signature\", \"operation\": \"truncate\", \"length\": 16}]\n    },\n    {\n      \"id\": \"signature-flip-bit\",\n      \"operations\": [{\"type\": \"signature\", \"operation\": \"flip_bit\", \"byte_index\": 0, \"bit_index\": 0}]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{jwtforge_url}}/mutation",
              "host": [
                "{{jwtforge_url}}"
              ],
              "path": [
                "mutation"
              ]
            },
            "description": "Create four independent variants from the exact accepted baseline. JWTForge does not re-sign the modified signatures."
          }
        },
        {
          "name": "Reject Removed Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target rejects token with removed signature', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{signature_removed_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "protected"
              ]
            },
            "description": "The baseline header and payload are unchanged; only the signature segment is empty."
          }
        },
        {
          "name": "Reject Replaced Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target rejects token with replaced signature', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{signature_replaced_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "protected"
              ]
            },
            "description": "The baseline signature is replaced with the literal Base64url value AQID."
          }
        },
        {
          "name": "Reject Truncated Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target rejects token with truncated signature', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{signature_truncated_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "protected"
              ]
            },
            "description": "The baseline signature is truncated to 16 bytes while preserving its header and payload."
          }
        },
        {
          "name": "Reject Bit-Flipped Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target rejects token with one flipped signature bit', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{signature_bit_flipped_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "protected"
              ]
            },
            "description": "Exactly one bit in the baseline signature is changed; accepting it indicates missing or defective signature verification."
          }
        }
      ]
    },
    {
      "name": "3. Algorithm Confusion",
      "description": "Tokens with unsafe or unexpected JWT algorithms must be rejected.",
      "item": [
