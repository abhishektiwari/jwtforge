    {
      "name": "4. Key Injection",
      "description": "Tokens that self-assert key location or key material must be rejected unless explicitly trusted by the verifier.",
      "item": [
        {
          "name": "Generate KID Traversal Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWTForge returned kid traversal token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.exist;",
                  "    pm.collectionVariables.set('attack_token', jsonData.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vulnerability\": \"kid_traversal\",\n  \"header\": {\n    \"typ\": \"JWT\",\n    \"kid\": \"../../../../../../dev/null\"\n  },\n  \"body\": {\n    \"iss\": \"{{issuer}}\",\n    \"aud\": \"{{audience}}\",\n    \"sub\": \"admin-user\",\n    \"roles\": [\"admin\"],\n    \"scope\": \"admin\"\n  }\n}"
            },
            "url": {
              "raw": "{{jwtforge_url}}/token",
              "host": [
                "{{jwtforge_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Generate a token whose kid header attempts filesystem/path traversal."
          }
        },
        {
          "name": "Reject KID Traversal Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target rejects kid traversal token', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attack_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
